# deploy/zeitspiegel.service — appliance unit (NFR-5, NFR-9).
# Installed by setup.sh to /etc/systemd/system/zeitspiegel.service.

[Unit]
Description=Zeitspiegel time-delayed video mirror
Documentation=https://github.com/danielmschmidt/zeitspiegel/tree/main/docs
# Start the mirror as early as possible — it needs no network (FR-12, ≤25 s
# to fullscreen). The HTTP server binds :80 immediately; clients reach it
# once they join the appliance's Wi-Fi, no ordering against the network
# needed. Take ownership of the HDMI console so no getty shares it.
After=local-fs.target
Conflicts=getty@tty1.service
# Restart=always below is defeated by systemd's default start-rate limit
# (5 starts / 10 s): a burst of early-boot failures (GPU/camera not yet
# enumerated) would flip the unit into a permanent 'failed' state and
# leave the screen black until a power cycle. An appliance never stops
# retrying.
StartLimitIntervalSec=0

[Service]
# SDL's KMSDRM backend needs a DRM card node, but this unit starts while
# udev may still be cold-plugging vc4. Rather than failing SDL init and
# burning restart cycles (each one a visible [FAILED] flash on the
# console), wait up to 5 s for /dev/dri/card* to appear. The '-' prefix
# makes a timeout non-fatal so the binary still surfaces the real error
# if DRM never comes.
ExecStartPre=-/bin/sh -c 'timeout 5 sh -c "until ls /dev/dri/card* >/dev/null 2>&1; do sleep 0.1; done"'
ExecStart=/usr/local/bin/zeitspiegel --config /etc/zeitspiegel/config.toml
# GC ceiling: max live heap ≈ buffer cap (1 GiB) + one pinned export +
# process overhead. Without it GOGC=100 lets the heap balloon toward 2×
# live between collections — multi-GB of JPEG slices and long marks whose
# assist pauses hit the render loop as visible stutter (NFR-2/NFR-3;
# accounting in docs/DEPLOYMENT.md).
Environment=GOMEMLIMIT=1400MiB
Restart=always
RestartSec=1
# tmpfs working dir at /run/zeitspiegel; exported clips land here and
# vanish on power loss — no persistent writes on the read-only root (NFR-9).
RuntimeDirectory=zeitspiegel
# Needs direct DRM/KMS (SDL KMSDRM, no X/Wayland) plus /dev/video0. Either
# root or a user in the video+render groups works; we keep User=root for v1
# simplicity on a sealed single-purpose appliance (read-only root, LAN-only).
User=root
# stdout/stderr go to the journal by default; logs stay volatile (NFR-9).

[Install]
WantedBy=multi-user.target
